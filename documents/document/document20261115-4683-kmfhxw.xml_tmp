<li id="_2c950120-9cd7-77e4-ac4a-328251d7fe1c"><fmt-name id="_a19bd23a-814e-ece9-6043-1d0e937a9d67">—</fmt-name><p id="_39c35ee7-5174-25b8-c375-56204804db1b" semx-id="_39c35ee7-5174-25b8-c375-56204804db1b"><link target="https://github.com/opengeospatial/ogc-geosparql/issues/574" id="_6dad3f38-3847-ec0b-7452-188bbcb23746"/><fmt-link target="https://github.com/opengeospatial/ogc-geosparql/issues/574"/></p>
</li>
